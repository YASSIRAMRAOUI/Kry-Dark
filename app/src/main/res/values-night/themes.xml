<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base dark theme application theme -->
    <style name="Theme.KryDarK" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_color_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_color_dark</item>
        <item name="colorSecondaryVariant">@color/secondary_variant_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_variant_dark</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/medium_gray</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>

        <!-- Card and component styles -->
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="android:itemBackground">@color/surface_dark</item>

        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.KryDarK.Button</item>

        <!-- Dialog styles -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.KryDarK.MaterialAlertDialog</item>

        <!-- Navigation styles -->
        <item name="bottomNavigationStyle">@style/Widget.KryDarK.BottomNavigationView</item>
    </style>

    <!-- Additional dark theme-specific styles -->
    <style name="Widget.KryDarK.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary_color_dark</item>
    </style>

    <style name="ThemeOverlay.KryDarK.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary_color_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="Widget.KryDarK.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/surface_dark</item>
        <item name="itemIconTint">@color/primary_color_dark</item>
        <item name="itemTextColor">@color/primary_color_dark</item>
    </style>
</resources>